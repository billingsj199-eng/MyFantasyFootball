rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // ---- Premium helpers (board-gating Phase C) ----
    // Server-checkable premium, mirroring the client's two sources:
    //  - users/{uid}.premium — written by the stripeWebhook Cloud Function
    //    ({status: 'active'|'trialing', currentPeriodEnd: ms})
    //  - gifted_premium/{email-key} — admin gift panel + redeemCode function
    //    ({expires: ms}); doc id = email lowercased, non-alphanumerics -> '_'
    // Any rules-evaluation error denies (fail closed).
    function isJack() {
      return request.auth != null
             && request.auth.token.email == 'billingsj199@gmail.com';
    }
    function _premMap() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('premium', {});
    }
    function hasStripePremium() {
      return request.auth != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && _premMap().get('status', '') in ['active', 'trialing']
             && _premMap().get('currentPeriodEnd', 0) > request.time.toMillis();
    }
    function _giftKey() {
      return request.auth.token.email.lower().replace('[^a-z0-9]', '_');
    }
    function hasGiftedPremium() {
      return request.auth != null
             && 'email' in request.auth.token
             && exists(/databases/$(database)/documents/gifted_premium/$(_giftKey()))
             && get(/databases/$(database)/documents/gifted_premium/$(_giftKey())).data.get('expires', 0) > request.time.toMillis();
    }

    // rankings/*: single block, no overlapping matches.
    //  - jacks-official: Jack's full shared boards — PREMIUM-ONLY read since
    //    board-gating Phase C (2026-08-11); free/anon sessions read the
    //    jacks-public slice and every reader falls back gracefully. Writes
    //    stay admin-only. (Full-board consumers that outlived the public
    //    read: site premium sessions, extension bridge payloads, and the
    //    exportJacksBoards Cloud Function for the exporters.)
    //  - jacks-public: free-tier slice (top 36, tiers inside the free window,
    //    IR flags, precomputed ticker movers) — public read, admin write.
    //  - every other doc id: a user's personal boards + EMAIL. Owner + admin
    //    only, both ways (2026-08-11 fix: read was public — anonymous REST
    //    could list every user's boards and email — and write was admin-only,
    //    which had silently rejected all non-admin saves since ~May; offline
    //    persistence made the Save button report success anyway).
    match /rankings/{docId} {
      allow read: if docId == 'jacks-public'
                  || (docId == 'jacks-official'
                      && (isJack() || hasStripePremium() || hasGiftedPremium()))
                  || (docId != 'jacks-official'
                      && docId != 'jacks-public'
                      && request.auth != null
                      && (request.auth.uid == docId || isJack()));
      allow write: if request.auth != null
                   && (request.auth.token.email == 'billingsj199@gmail.com'
                       || (docId != 'jacks-official'
                           && docId != 'jacks-public'
                           && request.auth.uid == docId));
    }
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    // users/{uid}/data/{docId}: per-user app data (e.g. adp_history from the
    // Underdog Draft Helper extension). User owns their own subcollection.
    match /users/{userId}/data/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /user_game_data/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /gifted_badges/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'billingsj199@gmail.com';
    }
    match /gifted_premium/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'billingsj199@gmail.com';
    }
    match /founders/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.token.email == 'billingsj199@gmail.com';
    }
    match /app_meta/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'billingsj199@gmail.com';
    }
    // settings/{docId}: site-wide config (e.g. active_week with publishedWeek).
    // Public read so non-admin users can see what week is currently published;
    // admin-only write since these toggle live UI state.
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'billingsj199@gmail.com';
    }
    match /prospect_draft_capital/{doc} {
      allow read, write: if request.auth != null && request.auth.token.email == 'billingsj199@gmail.com';
    }
    match /prospect_bio/{doc} {
      allow read, write: if request.auth != null && request.auth.token.email == 'billingsj199@gmail.com';
    }
    match /trivia_catalog/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'billingsj199@gmail.com';
    }
    // trivia_daily/{YYYY-MM-DD}: locked daily snapshots curated by admin.
    // Public read so anonymous players see the curated board; admin-only
    // write since this is the live "daily challenge" surface.
    match /trivia_daily/{date} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'billingsj199@gmail.com';
    }
    // trivia_reports/{reportId}: user-submitted "this cell looks wrong"
    // flags. Anyone can create (no auth required so anonymous players
    // can report) with strict shape validation; admin reads + deletes
    // to triage and clear queue. Cap text fields to prevent abuse.
    match /trivia_reports/{reportId} {
      allow read: if request.auth != null && request.auth.token.email == 'billingsj199@gmail.com';
      allow delete: if request.auth != null && request.auth.token.email == 'billingsj199@gmail.com';
      allow create: if request.resource.data.keys().hasOnly(['date','itemIdx','expected','guess','reason','createdAt','title'])
                    && (request.resource.data.date is string && request.resource.data.date.size() <= 16)
                    && (request.resource.data.expected is string && request.resource.data.expected.size() <= 200)
                    && (request.resource.data.guess is string && request.resource.data.guess.size() <= 200)
                    && (!('reason' in request.resource.data) || (request.resource.data.reason is string && request.resource.data.reason.size() <= 500))
                    && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 200))
                    && (request.resource.data.itemIdx is number && request.resource.data.itemIdx >= 0 && request.resource.data.itemIdx < 100)
                    && request.resource.data.createdAt is string
                    && request.resource.data.createdAt.size() <= 32;
      allow update: if false;
    }
    match /promo_uses/{docId} {
      allow read: if request.auth != null && request.auth.token.email == 'billingsj199@gmail.com';
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && request.auth.token.email == 'billingsj199@gmail.com';
    }
    // premium_codes/{CODE}: admin-created redeem codes. The admin panel does
    // full client-side CRUD (create / list / toggle disabled / delete). Regular
    // users NEVER touch this collection directly — the redeemCode Cloud Function
    // reads/validates codes and bumps `uses` with the admin SDK (which bypasses
    // these rules) — so client access is admin-only.
    match /premium_codes/{code} {
      allow read, write: if request.auth != null && request.auth.token.email == 'billingsj199@gmail.com';
    }
    // redeem_uses/{id}: per-redeem log + once-per-user enforcement source.
    // Written and read only by the redeemCode Cloud Function via the admin SDK;
    // no legitimate client path touches it, so client access is admin-only.
    match /redeem_uses/{id} {
      allow read, write: if request.auth != null && request.auth.token.email == 'billingsj199@gmail.com';
    }
    // creator_attributions/{uid}: tracks which creator referred the signup.
    // Written once by the user at signup, then locked. Admin can read/edit/delete.
    match /creator_attributions/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'billingsj199@gmail.com');
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && request.auth.token.email == 'billingsj199@gmail.com';
    }
    // shared/jacks_portfolio: mirror of Jack's Underdog portfolio so premium
    // members can view it. Read by any authed user (premium gating done
    // client-side, matching gifted_badges / gifted_premium pattern). Write
    // only by Jack so other accounts can't overwrite the shared portfolio.
    match /shared/jacks_portfolio {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'billingsj199@gmail.com';
    }
    // shared/ud_adp_latest: latest Underdog ADP snapshot (per-player BBM +
    // Superflex ADP), mirrored from Jack's session whenever the Draft Helper
    // extension applies its daily ADP refresh. PUBLIC read (unauthenticated)
    // so the daily consensus-ADP puller on Jack's PC can fetch it via the
    // Firestore REST API without credentials — the data is just public
    // Underdog ADP numbers, nothing sensitive. Write only by Jack.
    match /shared/ud_adp_latest {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'billingsj199@gmail.com';
    }
    // rankings_history/{timestamp}: rolling cloud backup of Jack's rankings,
    // written after every saveJacksRankings. Admin-only both ways — it's a
    // disaster-recovery mirror, never read by the app at runtime.
    match /rankings_history/{docId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'billingsj199@gmail.com';
    }
    // roster_overrides/{playerKey}: post-draft roster moves (trades/cuts) that
    // adjust prospect landing-spot signals. Loaded for ALL users (public read,
    // no auth required) so signals are consistent; admin-only write.
    match /roster_overrides/{playerKey} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'billingsj199@gmail.com';
    }
    // qa_questions/{uid}_{weekIdx}_{type}: premium "Ask Jack" weekly Q&A.
    // Each user gets 1 start/sit + 1 trade question per week (Tuesday reset).
    // The quota is enforced by the doc ID itself: users can only CREATE (never
    // update/delete), and the ID must be uid_weekIdx_type where weekIdx is
    // validated against request.time — weekIdx = floor((now - anchor) / 7d),
    // anchor = Tue 2026-01-06 00:00 EST (1767675600000 ms). Keep the anchor in
    // sync with QA_WEEK_ANCHOR in app.js. Premium gating is client-side,
    // matching shared/jacks_portfolio. Questions are structured as 2-4
    // `options` Jack picks from (start/sit players, or the two trade sides);
    // answers (pick/answer/answeredAt/status) are admin-only updates.
    match /qa_questions/{qId} {
      allow read: if request.auth != null
                  && (resource.data.uid == request.auth.uid
                      || request.auth.token.email == 'billingsj199@gmail.com');
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.type in ['startsit', 'trade']
                    && request.resource.data.weekIdx is int
                    && request.resource.data.weekIdx == (request.time.toMillis() - 1767675600000) / 604800000
                    && qId == (request.auth.uid + '_' + string(request.resource.data.weekIdx) + '_' + request.resource.data.type)
                    && request.resource.data.status == 'open'
                    && request.resource.data.keys().hasOnly(['uid','name','type','weekIdx','status','createdAt','options','q','league','roster'])
                    && request.resource.data.options is list
                    && request.resource.data.options.size() >= 2
                    && request.resource.data.options.size() <= 4
                    && (request.resource.data.options[0] is string && request.resource.data.options[0].size() <= 200)
                    && (request.resource.data.options[1] is string && request.resource.data.options[1].size() <= 200)
                    && (request.resource.data.options.size() < 3 || (request.resource.data.options[2] is string && request.resource.data.options[2].size() <= 200))
                    && (request.resource.data.options.size() < 4 || (request.resource.data.options[3] is string && request.resource.data.options[3].size() <= 200))
                    && (request.resource.data.name is string && request.resource.data.name.size() <= 120)
                    && (request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 32)
                    && (!('q' in request.resource.data) || (request.resource.data.q is string && request.resource.data.q.size() <= 1000))
                    && (!('league' in request.resource.data) || (
                          request.resource.data.league is map
                          && request.resource.data.league.keys().hasOnly(['id','name','fmt'])
                          && (!('id' in request.resource.data.league) || (request.resource.data.league.id is string && request.resource.data.league.id.size() <= 60))
                          && (!('name' in request.resource.data.league) || (request.resource.data.league.name is string && request.resource.data.league.name.size() <= 80))
                          && (!('fmt' in request.resource.data.league) || (request.resource.data.league.fmt is string && request.resource.data.league.fmt.size() <= 80))
                       ))
                    && (!('roster' in request.resource.data) || (request.resource.data.roster is list && request.resource.data.roster.size() <= 60));
      allow update, delete: if request.auth != null && request.auth.token.email == 'billingsj199@gmail.com';
    }
    // shared_rankings/{shareId}: snapshots of a user's My Rankings, generated
    // by the SHARE button in the rankings toolbar. Anyone with the link can
    // view; only signed-in users can create one (and only owned by themselves);
    // only the owner can update or delete. Size cap prevents abuse.
    match /shared_rankings/{shareId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.order.size() > 0
                    && request.resource.data.order.size() <= 600;
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.ownerUid;
    }
  }
}
