{
  "manifest_version": 3,
  "name": "MFF Sleeper Helper",
  "version": "0.29.10",
  "description": "Draft + season helper for Sleeper leagues: live pick recs, optimal lineups, waiver upgrades, and roster values from Jack's boards.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://api.sleeper.app/*",
    "https://firestore.googleapis.com/*",
    "https://sleeper.com/*",
    "https://*.sleeper.com/*",
    "https://myfantasyfootball.co/*",
    "https://www.myfantasyfootball.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sleeper.com/*",
        "https://*.sleeper.com/*"
      ],
      "js": [
        "data/playoff_sos_2026.js",
        "data/sim_pack.js",
        "data/sim_overrides.js",
        "engine_sim.js",
        "sidebar.js"
      ],
      "css": [
        "sidebar.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://myfantasyfootball.co/*",
        "https://www.myfantasyfootball.co/*"
      ],
      "js": [
        "mff-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://myfantasyfootball.co/*",
        "https://www.myfantasyfootball.co/*"
      ],
      "js": [
        "mff-page-user.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/players.json"
      ],
      "matches": [
        "https://sleeper.com/*",
        "https://*.sleeper.com/*"
      ]
    }
  ],
  "icons": {
    "128": "icons/icon-128.png"
  }
}