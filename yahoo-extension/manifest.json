{
  "manifest_version": 3,
  "name": "MFF Yahoo Helper",
  "version": "0.9.4",
  "description": "Draft assistant + season helper for Yahoo leagues: live pick recs, optimal lineups, waivers, season sims, and league export.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://football.fantasysports.yahoo.com/*",
    "https://api.sleeper.app/*",
    "https://firestore.googleapis.com/*",
    "https://myfantasyfootball.co/*",
    "https://www.myfantasyfootball.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://football.fantasysports.yahoo.com/*"
      ],
      "js": [
        "data/playoff_sos_2026.js",
        "data/sim_pack.js",
        "data/sim_overrides.js",
        "engine_sim.js",
        "sidebar.js",
        "yahoo-normalize.js",
        "yahoo-export.js",
        "draft-mode.js"
      ],
      "css": [
        "sidebar.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://football.fantasysports.yahoo.com/*"
      ],
      "js": [
        "probe.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://myfantasyfootball.co/*",
        "https://www.myfantasyfootball.co/*"
      ],
      "js": [
        "mff-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://myfantasyfootball.co/*",
        "https://www.myfantasyfootball.co/*"
      ],
      "js": [
        "mff-page-user.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/players.json"
      ],
      "matches": [
        "https://football.fantasysports.yahoo.com/*"
      ]
    }
  ],
  "icons": {
    "128": "icons/icon-128.png"
  }
}